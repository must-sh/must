
import "std/prelude.must"

fn square(x: int64) -> int64 {
    x * x
}

fn is_prime(x: int64) -> bool {
    let mut res = true in
    let mut n = 2 in
    while square(n) <= x {
        if x % n == 0 {
            res = false
        };
        n = n + 1
    };
    res
}

fn main() -> int64 {
    let mut i = 2 in
    while i < 30 {
        if is_prime(i) { print_int(i) };
        i = i + 1
    };
    0
}
