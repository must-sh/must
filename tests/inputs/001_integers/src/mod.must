

fn foo(x: int32) -> int64 {
    13
}

fn bar() -> int32 {
    1
}

struct Point {
    x: float64,
    y: float64,
}

fn radius(p: Point) -> float64 {
    std::math::sqrt(p.x * p.x + p.y * p.y)
}

fn main() {
    let x = 3 in
    let p = Point .{ x = 3, y = 4 } in
    std::must_printf(radius(p))
}
