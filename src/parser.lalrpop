use crate::ast::*;
use crate::tp::{TypeId, TypeData};
use crate::bytecode;
use crate::diagnostic::Diagnostic;
use salsa::Accumulator;
use crate::common::{Binop, Unop};
use crate::input::{unescape_json_string, parse_char_literal};

grammar<'db>(db: &'db dyn salsa::Database, source: crate::input::Source);

match {
    r"\s*" => { },
    r"#[^\n\r]*[\n\r]*" => { },
} else { _ }

// ==== Macros =================================================================

CommaSep<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

TwoOrMore<T>: Vec<T> = {
    <first:T> "," <second:T> <rest: ("," <T>)*> (",")? => {
        let mut v = Vec::new();
        v.push(first);
        v.push(second);
        for t in rest {
            v.push(t);
        }
        v
    }
};

// ==== Grammar ================================================================

pub File: File<'db> = {
    <defs: Def+> => File::new(db, defs),
}

FnArg: (PatternId<'db>, TypeId<'db>) = {
    <pat: Pattern> ":" <tp: Type> => (pat, tp),
}

Def: Def<'db> = {
    FnDef => Def::Fn(<>),
    StructDef => Def::Struct(<>),
    "import" <path: StrLit> => Def::Import(path),
}

StructField: (Ident<'db>, TypeId<'db>) = {
    <id: Ident> ":" <tp: Type> => (id, tp),
}

StructDef: StructDef<'db> = {
    "struct" <l: @L> <id: Ident> <r: @R> "{"
        <fields: CommaSep<StructField>>
    "}" => {
            let span = Span::new(db, l, r);
            StructDef::new(db, id, span, fields, source)
        }
}

FnDef: FnDef<'db> = {
    "fn" <l: @L> <name: Ident> <r: @R> "(" <args: CommaSep<FnArg>> ")" <ret: ("->" <Type>)?> "{"
        <body: Expr0>
    "}" => {
            let span = Span::new(db, l, r);
            FnDef::new(db, false, name, span, args, ret, Some(body), source)
        },

    "extern" "fn" <l: @L> <name: Ident> <r: @R> "(" <args: CommaSep<FnArg>> ")" <ret: ("->" <Type>)?> "{"
        <body: Expr0>
    "}" => {
            let span = Span::new(db, l, r);
            FnDef::new(db, true, name, span, args, ret, Some(body), source)
        },

    "extern" "fn" <l: @L> <name: Ident> <r: @R> "(" <args: CommaSep<FnArg>> ")" <ret: ("->" <Type>)?> ";"
        => {
            let span = Span::new(db, l, r);
            FnDef::new(db, true, name, span, args, ret, None, source)
        }
}

Ident: Ident<'db> = {
    r"[a-zA-Z_][a-zA-Z_0-9]*" => Ident::new(db, <>.to_string())
}

StrLit: StrLit<'db> = {
    r#""([^"\\\x00-\x1F]|\\(["\\bnfrt/]|u[a-fA-F0-9]{4}))*""# => StrLit::new(db, unescape_json_string(<>).unwrap())
}

CharLit: u8 = {
    r"'([^'\\]|\\.)'" => {
        parse_char_literal(<>).unwrap()
    }
};

Num: i64 = <s: r"[0-9]+"> => s.parse().unwrap();

// ==== Expressions ============================================================

SpannedExpr<Data>: ExprId<'db> = {
    <l: @L> <data: Data> <r: @R> => {
        let span = Span::new(db, l, r);
        ExprId::new(db, data, span)
    }
};

Expr0 = SpannedExpr<Expr0Data>;
Expr1 = SpannedExpr<Expr1Data>;
Expr5 = SpannedExpr<Expr5Data>;
Expr3 = SpannedExpr<Expr3Data>;
Expr9 = SpannedExpr<Expr9Data>;
Expr10 = SpannedExpr<Expr10Data>;
Expr20 = SpannedExpr<Expr20Data>;
Expr30 = SpannedExpr<Expr30Data>;
Expr35 = SpannedExpr<Expr35Data>;
Expr40 = SpannedExpr<Expr40Data>;

Expr0Data: ExprData<'db> = {
    "let" <pat: Pattern> "=" <e1: Expr0> "in" <e2: Expr0> => ExprData::Let(pat, e1, e2),
    Expr1Data,
}

Expr1Data: ExprData<'db> = {
    <e1: Expr3> ";" <e2: Expr0> => ExprData::Seq(e1, e2),
    Expr3Data,
}

Expr3Data: ExprData<'db> = {
    "if" <cond: Expr0> "{" <th: Expr0> "}" <el: ("else" "{" <Expr0> "}")?> => ExprData::If(cond, th, el),
    "while" <cond: Expr5> "{" <body: Expr0> "}" => ExprData::While(cond, body),
    Expr5Data,
}

Expr5Data: ExprData<'db> = {
    <e1: Expr10> "=" <e2: Expr5> => ExprData::Assign(e1, e2),
    Expr9Data,
}

Expr9Data: ExprData<'db> = {
    <x: Expr9> "&&" <y: Expr10> => ExprData::Binop(Binop::And, x, y),
    <x: Expr9> "||" <y: Expr10> => ExprData::Binop(Binop::Or, x, y),
    Expr10Data,
}

Expr10Data: ExprData<'db> = {
    <x: Expr10> "==" <y: Expr20> => ExprData::Binop(Binop::Eq, x, y),
    <x: Expr10> "!=" <y: Expr20> => ExprData::Binop(Binop::NEq, x, y),
    <x: Expr10> "<" <y: Expr20> => ExprData::Binop(Binop::Lt, x, y),
    <x: Expr10> ">" <y: Expr20> => ExprData::Binop(Binop::Gt, x, y),
    <x: Expr10> "<=" <y: Expr20> => ExprData::Binop(Binop::Le, x, y),
    <x: Expr10> ">=" <y: Expr20> => ExprData::Binop(Binop::Ge, x, y),
    Expr20Data,
}

Expr20Data: ExprData<'db> = {
    <x: Expr20> "+" <y: Expr30> => ExprData::Binop(Binop::Add, x, y),
    <x: Expr20> "-" <y: Expr30> => ExprData::Binop(Binop::Sub, x, y),
    Expr30Data,
}

Expr30Data: ExprData<'db> = {
    <x: Expr30> "*" <y: Expr35> => ExprData::Binop(Binop::Mul, x, y),
    <x: Expr30> "/" <y: Expr35> => ExprData::Binop(Binop::Div, x, y),
    <x: Expr30> "%" <y: Expr35> => ExprData::Binop(Binop::Mod, x, y),
    Expr35Data
}

Expr35Data: ExprData<'db> = {
    "*" <e: Expr35> => ExprData::Deref(e),
    "&" <e: Expr35> => ExprData::AddressOf(e),
    "!" <e: Expr35> => ExprData::Unop(Unop::Not, e),
    "-" <e: Expr35> => ExprData::Unop(Unop::Neg, e),
    <start: Expr40> ".." <end: Expr40> => ExprData::Range(start, end),
    Expr40Data
}

Expr40Data: ExprData<'db> = {
    "(" ")" => ExprData::Tuple(vec![]),
    "(" <e: Expr0Data> ")" => e,
    "(" <exprs: TwoOrMore<Expr0>> ")" => ExprData::Tuple(exprs),
    <id: Ident> => ExprData::Var(id),
    <e: Expr40> "(" <args: CommaSep<Expr0>> ")" => ExprData::FnCall(e, args),
    <n: Num> => ExprData::Number(n),
    <s: StrLit> => ExprData::Str(s),
    <c: CharLit> => ExprData::Char(c),
    "true" => ExprData::Bool(true),
    "false" => ExprData::Bool(false),

    <e: Expr40> "." <id: Ident> => ExprData::Field(e, id),
    <e1: Expr40> "[" <e2: Expr0> "]" => ExprData::Index(e1, e2),
    <id: Ident> ".{" <fields: CommaSep<StructInit>> "}" => ExprData::Struct(id, fields),
    "[" <exprs: CommaSep<Expr0>> "]" => ExprData::Array(exprs),

    <e: Expr40> "as" <tp: Type> => ExprData::Cast(e, tp),

    ! => {
        Diagnostic::parser_error(<>.error, source).accumulate(db);
        ExprData::Error
    }
};

StructInit: (Ident<'db>, ExprId<'db>) = {
    <id: Ident> "=" <e: Expr0> => (id, e),
}

// ==== Patterns ===============================================================

SpannedPattern<Data>: PatternId<'db> = {
    <l: @L> <data: Data> <r: @R> => {
        let span = Span::new(db, l, r);
        PatternId::new(db, data, span)
    }
};

Pattern = SpannedPattern<PatternData>;

PatternData: PatternData<'db> = {
    "_" => PatternData::Wildcard,
    "(" ")" => PatternData::Tuple(vec![]),
    <id: Ident> => PatternData::Var(id, false),
    "mut" <id: Ident> => PatternData::Var(id, true),
    "(" <pats: TwoOrMore<Pattern>> ")" => PatternData::Tuple(pats),
};

// ==== Type expressions =======================================================

SpannedType<Data>: TypeId<'db> = {
    <l: @L> <data: Data> <r: @R> => {
        // let span = Span::new(db, l, r);
        TypeId::new(db, data)
    }
};

Type = SpannedType<TypeData>;

TypeData: TypeData<'db> = {
    "int8" => TypeData::Primitive(bytecode::Type::Int8),
    "int16" => TypeData::Primitive(bytecode::Type::Int16),
    "int32" => TypeData::Primitive(bytecode::Type::Int32),
    "int64" => TypeData::Primitive(bytecode::Type::Int64),
    "int128" => TypeData::Primitive(bytecode::Type::Int128),

    "uint8" => TypeData::Primitive(bytecode::Type::UInt8),
    "uint16" => TypeData::Primitive(bytecode::Type::UInt16),
    "uint32" => TypeData::Primitive(bytecode::Type::UInt32),
    "uint64" => TypeData::Primitive(bytecode::Type::UInt64),
    "uint128" => TypeData::Primitive(bytecode::Type::UInt128),

    "float16" => TypeData::Primitive(bytecode::Type::Float16),
    "float32" => TypeData::Primitive(bytecode::Type::Float32),
    "float64" => TypeData::Primitive(bytecode::Type::Float64),
    "float128" => TypeData::Primitive(bytecode::Type::Float128),

    "bool" => TypeData::Primitive(bytecode::Type::Bool),
    "*" <tp: Type> => TypeData::Ptr(tp, false),
    "*" "mut" <tp: Type> => TypeData::Ptr(tp, true),
    "(" ")" => TypeData::Tuple(vec![]),
    "(" <tps: TwoOrMore<Type>> ")" => TypeData::Tuple(tps),
    <id: Ident> => TypeData::Var(source, id),
    "[" <n: Num> "]" <tp: Type> => TypeData::Array(n as usize, tp),
    "[" "]" <tp: Type> => TypeData::Slice(tp, false),
    "[" "]" "mut" <tp: Type> => TypeData::Slice(tp, true),
}
